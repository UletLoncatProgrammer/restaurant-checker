# Copy to .env for local development. Production values come from the per-company
# .env that deploy/new-company.sh generates - never reuse these placeholders there.
DATABASE_URL="postgresql://restaurant:restaurant@localhost:5432/restaurant_checker?schema=public"
JWT_SECRET="dev-only-secret-change-me"
PORT=4000
# Comma separated list of exact origins that may call the API. "*" is refused in production.
# The Android app (Capacitor, androidScheme https) uses https://localhost and the Windows app (Electron) uses app://rc - see deploy/README.md.
CORS_ORIGIN="http://localhost:5173"
# NODE_ENV=production
# COMPANY_NAME="Acme Foods"
# TOKEN_TTL=12h
# BCRYPT_COST=12
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=5
